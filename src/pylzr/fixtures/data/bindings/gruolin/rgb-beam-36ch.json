      "name": "x_color_change",
      "kind": "option",
      "options": ["rgb", "original"],
      "description": "The Gruolin's own colour changes: red-green-blue, or the pattern's original colours changing (instead of color)"
    },
    {
      "name": "x_bright_scan",
      "kind": "continuous",
      "description": "Brightening line scan speed: 0 off … 1 fastest (instead of draw_style and scan_speed)"
    },
    {
      "name": "x_move_style",
      "kind": "option",
      "options": ["wrap", "gap"],
      "description": "How move_x and move_y scroll: wrap (edge to edge) or gap (fully off before coming back)"
    },
    {
      "name": "x_shift_x",
      "kind": "bipolar",
      "description": "Second horizontal position: −1 inner edge … 0 centre … +1 outer edge; the two outputs are mirrored. Used while move_x is 0"
    },
    {
      "name": "x_shift_y",
      "kind": "bipolar",
      "description": "Second vertical position: −1 inner edge … 0 centre … +1 outer edge. Used while move_y is 0"
    },
    {
      "name": "x_zoom_pulse_2",
      "kind": "continuous",
      "description": "The second zoom pulse (looked the same as pulse): 0 off … 1 fastest"
    }
