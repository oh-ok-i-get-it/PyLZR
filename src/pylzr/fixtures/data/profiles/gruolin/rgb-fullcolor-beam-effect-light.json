{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "RGB Fullcolor Beam Effect Light",
  "shortName": "Gruolin RGB Beam",
  "categories": ["Laser"],
  "meta": {
    "authors": ["Hayden"],
    "createDate": "2026-11-10",
    "lastModifyDate": "2026-11-10"
  },
  "comment": "A dual-output RGB laser: two patterns, each with its own size, position, colour and motion channels (36-channel mode). From the printed manual, checked on the laser; \"helpWanted\" marks what is assumed rather than checked.",
  "availableChannels": {
    "On/Off": {
      "capabilities": [
        {
          "dmxRange": [0, 0],
          "type": "ShutterStrobe",
          "shutterEffect": "Closed",
          "comment": "Light off"
        },
        {
          "dmxRange": [1, 255],
          "type": "ShutterStrobe",
          "shutterEffect": "Open",
          "comment": "Light on: every value above 0 is fully on (the manual says 1–100 %; checked on the laser)"
        }
      ]
    },
    "Auto Speed": {
      "capabilities": [
        {
          "dmxRange": [0, 26],
