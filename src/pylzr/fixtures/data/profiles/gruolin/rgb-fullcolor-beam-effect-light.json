          "comment": "Default auto speed"
        },
        {
          "dmxRange": [27, 127],
          "type": "EffectSpeed",
          "speedStart": "slow",
          "speedEnd": "fast",
          "comment": "Auto and dynamic effect speed; a static pattern needs a colour change effect to show it"
        },
        {
          "dmxRange": [128, 255],
          "type": "SoundSensitivity",
          "soundSensitivityStart": "low",
          "soundSensitivityEnd": "high"
        }
